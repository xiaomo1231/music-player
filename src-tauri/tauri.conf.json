{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "极光播放器",
  "version": "0.6.0",
  "identifier": "com.xiaomo.musicplayer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node tools/fetch-tools.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "极光播放器",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "xiaomo",
    "shortDescription": "极光播放器",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "bin/": "bin/" },
    "fileAssociations": [
      { "ext": ["em"], "name": "AuroraPlayerRule", "description": "极光播放器规则文件", "role": "Viewer" },
      { "ext": ["mpx"], "name": "AuroraPlayerPlugin", "description": "极光播放器插件包", "role": "Viewer" }
    ],
    "windows": { "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwM0ZEQTI2Qjk2QzQ2OUQKUldTZFJteTVKdG8vd0QrUkpiK3dQVm0ySmZwUlczaHVEMTltRVV3OWFwcVV6SEEwYlBDL0EzVmQK",
      "endpoints": ["https://github.com/xiaomo1231/music-player/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
